    "lines": [
        {
            "speaker": "達多·莫那",
            "text": "父親！",
            "cue": "Hilt",
            "time": 6.360403537750244,
            "visualLines": 1
        },
        {
            "speaker": "達多·莫那",
            "text": "日本人逼我們砍巨木、扣工資，",
            "cue": "Hilt",
            "time": 8.568987846374512,
            "visualLines": 1
        },
        {
            "speaker": "達多·莫那",
            "text": "連敬酒都要被打！",
            "cue": "Hilt",
            "time": 11.984076499938965,
            "visualLines": 1
        },
        {
            "speaker": "達多·莫那",
            "text": "我們還要忍到什麼時候？",
            "cue": "Hilt",
            "time": 14.588376998901368,
            "visualLines": 1
        },
        {
            "speaker": "瓦旦",
            "text": "達多，冷靜！",
            "cue": "Concern",
            "time": 18.64025115966797,
            "visualLines": 1
        },
        {
            "speaker": "瓦旦",
            "text": "日本人的槍砲比樹葉還多。",
            "cue": "Concern",
            "time": 21.004310607910158,
            "visualLines": 1
        },
        {
            "speaker": "瓦旦",
            "text": "動了手，",
            "cue": "Concern",
            "time": 24.185375213623048,
            "visualLines": 1
        },
        {
            "speaker": "瓦旦",
            "text": "部落的婦女和孩子怎麼辦？",
            "cue": "Concern",
            "time": 26.383989334106447,
            "visualLines": 1
        },
        {
            "speaker": "瓦旦",
            "text": "莫那，這是一條死路啊！",
            "cue": "Concern",
            "time": 29.527477264404298,
            "visualLines": 1
        },
        {
            "speaker": "莫那·魯道",
            "text": "死路？",
            "cue": "Fire",
            "time": 33.62111282348633,
            "visualLines": 1
        },
        {
            "speaker": "莫那·魯道",
            "text": "瓦旦，看看我們的年輕人，",
            "cue": "Fire",
            "time": 35.86749267578125,
            "visualLines": 1
        },
        {
            "speaker": "莫那·魯道",
            "text": "手是用來握獵刀的，",
            "cue": "Fire",
            "time": 39.01900100708008,
            "visualLines": 1
        },
        {
            "speaker": "莫那·魯道",
            "text": "現在卻在幫日人扛木材。",
            "cue": "Fire",
            "time": 41.793601989746097,
            "visualLines": 1
        },
        {
            "speaker": "莫那·魯道",
            "text": "丟了 Gaya（祖靈的教誨），",
            "cue": "Fire",
            "time": 44.81619644165039,
            "visualLines": 1
        },
        {
            "speaker": "莫那·魯道",
            "text": "我們活著和野獸有什麼兩樣？",
            "cue": "Fire",
            "time": 48.452510833740237,
            "visualLines": 1
        },
        {
            "speaker": "巴萬·拿威",
            "text": "頭目！",
            "cue": "Resolve",
            "time": 52.821754455566409,
            "visualLines": 1
        },
        {
            "speaker": "巴萬·拿威",
            "text": "我寧可做自由的鬼，",
            "cue": "Resolve",
            "time": 55.054054260253909,
            "visualLines": 1
        },
        {
            "speaker": "巴萬·拿威",
            "text": "也不做屈辱的人！",
            "cue": "Resolve",
            "time": 57.79664993286133,
            "visualLines": 1
        },
        {
            "speaker": "瓦旦",
            "text": "我們打不贏日本帝國的……",
            "cue": "EyesClosed",
            "time": 61.39925765991211,
            "visualLines": 1
        },
        {
            "speaker": "莫那·魯道",
            "text": "明天的運動會，",
            "cue": "Declare",
            "time": 67.02764892578125,
            "visualLines": 1
        },
        {
            "speaker": "莫那·魯道",
            "text": "日本官吏都在公學校。",
            "cue": "Declare",
            "time": 69.4697036743164,
            "visualLines": 1
        },
        {
            "speaker": "莫那·魯道",
            "text": "那是祖靈給的唯一機會！",
            "cue": "Declare",
            "time": 72.41712188720703,
            "visualLines": 1
        },
        {
            "speaker": "莫那·魯道",
            "text": "我莫那·魯道已經決定起義，",
            "cue": "Declare",
            "time": 75.42057037353516,
            "visualLines": 1
        },
        {
            "speaker": "莫那·魯道",
            "text": "用鮮血洗刷屈辱！",
            "cue": "Declare",
            "time": 78.7037124633789,
            "visualLines": 1
        },
        {
            "speaker": "莫那·魯道",
            "text": "賽德克巴萊的子孫們，",
            "cue": "Declare",
            "time": 81.27934265136719,
            "visualLines": 1
        },
        {
            "speaker": "莫那·魯道",
            "text": "你們，願不願意跟隨我？",
            "cue": "Declare",
            "time": 84.1604995727539,
            "visualLines": 1
        },
        {
            "speaker": "達多·莫那",
            "text": "我跟隨您！",
            "cue": "Planted",
            "time": 93.2522201538086,
            "visualLines": 1
        },
        {
            "speaker": "達多·莫那",
            "text": "為了祖靈，血祭彩虹！",
            "cue": "Planted",
            "time": 95.42367553710938,
            "visualLines": 1
        },
        {
            "speaker": "巴萬與眾戰士",
            "text": "我們跟隨您！",
            "cue": "Pledge",
            "time": 102.08720397949219,
            "visualLines": 1
        },
        {
            "speaker": "巴萬與眾戰士",
            "text": "為了祖靈！",
            "cue": "Pledge",
            "time": 104.39696502685547,
            "visualLines": 1
        },
        {
            "speaker": "巴萬與眾戰士",
            "text": "血祭彩虹！",
            "cue": "Pledge",
            "time": 106.70293426513672,
            "visualLines": 1
        },
        {
            "speaker": "莫那·魯道",
            "text": "好！",
            "cue": "Nod",
            "time": 110.06297302246094,
            "visualLines": 1
        },
        {
            "speaker": "莫那·魯道",
            "text": "今夜回去對妻兒好一點，",
            "cue": "Nod",
            "time": 112.2549057006836,
            "visualLines": 1
        },
        {
            "speaker": "莫那·魯道",
            "text": "別露破綻。",
            "cue": "Nod",
            "time": 115.26883697509766,
            "visualLines": 1
        },
        {
            "speaker": "莫那·魯道",
            "text": "天亮之後……我們彩虹橋上見！",
            "cue": "Nod",
            "time": 117.43025970458985,
            "visualLines": 1
        }
    ],
