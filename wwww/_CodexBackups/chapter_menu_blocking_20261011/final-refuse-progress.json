            "time": 8.680334091186524,
            "gazeError": 0.0,
            "wristBend": 0.0,
            "fist": 0.0,
            "visualLines": 1,
            "speakerLines": 1
        },
        {
            "speaker": "達多·莫那（莫那·魯道之子）",
            "text": "連敬酒都要被打！",
