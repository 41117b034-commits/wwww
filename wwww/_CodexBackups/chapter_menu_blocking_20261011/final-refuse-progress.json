            "time": 14.124994277954102,
            "gazeError": 0.0,
            "wristBend": 0.0,
            "fist": 0.0,
            "visualLines": 1,
            "speakerLines": 1
        },
        {
            "speaker": "瓦旦（長老代表）",
            "text": "達多，冷靜！",
