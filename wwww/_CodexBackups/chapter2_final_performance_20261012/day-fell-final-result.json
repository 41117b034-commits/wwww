    "speech": [
        {
            "actor": "阿威·比胡",
            "text": "前面就是西仔希克。這片森林，守護著我們的生活。",
            "mouthMax": 0.8999999761581421
        },
        {
            "actor": "阿威·比胡",
            "text": "現在開始你可以自由探索，了解這裡的環境",
            "mouthMax": 0.8526697158813477
        },
        {
            "actor": "阿威·比胡",
            "text": "沿著這條小徑，跟我來。不要離隊太遠。",
            "mouthMax": 0.7785223722457886
        },
        {
            "actor": "阿威·比胡",
            "text": "這棵巨木是我們的守護者……真的要砍下去嗎？",
            "mouthMax": 0.8999999761581421
        },
        {
            "actor": "阿威·比胡",
            "text": "退後……它要倒下了。",
            "mouthMax": 0.39824172854423525
        },
        {
            "actor": "阿威·比胡",
            "text": "命令完成了。可是，我們該怎麼面對祖靈？",
            "mouthMax": 0.772243320941925
        }
    ],
