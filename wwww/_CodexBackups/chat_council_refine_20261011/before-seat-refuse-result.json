            "gazeError": 0.0,
            "wristBend": 0.0,
            "fist": 0.0,
            "visualLines": 1,
            "speakerLines": 1
        },
        {
            "speaker": "達多·莫那（莫那·魯道之子）",
            "text": "連敬酒都要被打！",
            "cue": "Hilt",
            "time": 11.078814506530762,
            "gazeError": 0.0,
            "wristBend": 0.0,
            "fist": 0.0,
            "visualLines": 1,
            "speakerLines": 1
        },
        {
            "speaker": "達多·莫那（莫那·魯道之子）",
            "text": "我們還要忍到什麼時候？",
