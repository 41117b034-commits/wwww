            "time": 11.126850128173829,
            "gazeError": 0.0,
            "wristBend": 0.0,
            "fist": 0.0,
            "visualLines": 1,
            "speakerLines": 1
        },
        {
            "speaker": "達多·莫那（莫那·魯道之子）",
            "text": "我們還要忍到什麼時候？",
