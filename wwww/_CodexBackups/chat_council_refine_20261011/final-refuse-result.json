            "gazeError": 0.0,
            "wristBend": 0.0,
            "fist": 0.0,
            "visualLines": 1,
            "speakerLines": 1
        },
        {
            "speaker": "瓦旦（長老代表）",
            "text": "日本人的槍砲比樹葉還多。",
