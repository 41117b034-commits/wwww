        },
        {
            "speaker": "達多·莫那（莫那·魯道之子）",
            "text": "日本人逼我們砍巨木、扣工資，",
            "cue": "Hilt",
            "time": 8.000069618225098,
            "gazeError": 0.0,
            "wristBend": 0.0,
            "fist": 0.0,
            "visualLines": 1,
            "speakerLines": 1
        },
        {
            "speaker": "達多·莫那（莫那·魯道之子）",
            "text": "連敬酒都要被打！",
